.summary {
  /* 渐变跟随主题色（--brand / --brand-dark 由页面根节点注入） */
  background: linear-gradient(135deg, var(--brand, #0a8f5b) 0%, var(--brand-dark, #0a7d4f) 100%);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.16);
}

.summary__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.summary__title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 600;
}

.summary__caption {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  background-color: rgba(255, 255, 255, 0.16);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.summary__grid {
  display: flex;
  align-items: flex-end;
}

.summary__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.summary__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 8rpx;
}

.summary__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5rpx;
}

/* 优惠用浅红，实付用略暗的白，保持与列表页语义一致 */
.summary__value--discount {
  color: #ffd9d9;
}

.summary__value--paid {
  color: rgba(255, 255, 255, 0.92);
}

.summary__symbol {
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 2rpx;
  opacity: 0.85;
}
