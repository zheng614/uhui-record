.filter {
  width: 100%;
}

.filter__chips {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

.chip {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 12rpx;
  transition: background-color 0.15s ease, color 0.15s ease;
}

.chip--active {
  background-color: var(--brand-soft, #e8f5ee);
  color: var(--brand, #0a8f5b);
  font-weight: 600;
}

.filter__custom {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

.date-field {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: #f4f6f8;
  border-radius: 12rpx;
}

.date-field__label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-right: 10rpx;
}

.date-field__value {
  font-size: 26rpx;
  color: #1f2328;
  font-variant-numeric: tabular-nums;
}

.date-sep {
  font-size: 24rpx;
  color: #a2a8b3;
  margin: 0 16rpx;
}
